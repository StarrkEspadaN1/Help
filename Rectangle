public class Rectangle : GeometricFigure, ISimplePolygon
{
    public double Width { get; }
    public double Height { get; }
    public Rectangle(double width, double height)
    {
        if (width <= 0 || height <= 0) throw new ArgumentException("Размеры должны быть положительными.");
        Width = width; Height = height;
    }
    public override double Area => Width * Height;
    public override double Perimeter => 2 * (Width + Height);
    double ISimplePolygon.Height => Height;
    double ISimplePolygon.Base => Width;
    public double AngleBetweenDiagonalAndSide => Math.Atan(Height / Width) * 180 / Math.PI;
    public int SidesCount => 4;
    public double[] SideLengths => new[] { Width, Height, Width, Height };

    public override void Draw(int originX, int originY, ConsoleColor color)
    {
        int w = (int)Math.Round(Width);
        int h = (int)Math.Round(Height);
        Console.ForegroundColor = color;
        for (int i = 0; i < h; i++)
        {
            Console.SetCursorPosition(originX, originY + i);
            Console.Write(new string('*', w));
        }
        Console.ResetColor();
    }
}
