public class Triangle : GeometricFigure, ISimplePolygon
{
    public double SideA { get; }
    public double SideB { get; }
    public double SideC { get; }

    public Triangle(double a, double b, double c)
    {
        if (a <= 0 || b <= 0 || c <= 0)
            throw new ArgumentException("Стороны должны быть положительными.");
        if (a + b <= c || a + c <= b || b + c <= a)
            throw new ArgumentException("Нарушено неравенство треугольника.");
        SideA = a; SideB = b; SideC = c;
    }

    public override double Area
    {
        get
        {
            double p = Perimeter / 2;
            return Math.Sqrt(p * (p - SideA) * (p - SideB) * (p - SideC));
        }
    }

    public override double Perimeter => SideA + SideB + SideC;

    // Реализация ISimplePolygon (для треугольника определим высоту к стороне A)
    public double Height => 2 * Area / SideA;
    public double Base => SideA;
    public double AngleBetweenDiagonalAndSide => throw new NotImplementedException("Не применимо для треугольника");
    public int SidesCount => 3;
    public double[] SideLengths => new[] { SideA, SideB, SideC };

    public override void Draw(int originX, int originY, ConsoleColor color)
    {
        // Рисуем прямоугольный треугольник (размер – гипотенуза ~ максимальная сторона)
        int size = (int)Math.Round(SideA); // основание
        Console.ForegroundColor = color;
        for (int i = 0; i < size; i++)
        {
            Console.SetCursorPosition(originX, originY + i);
            for (int j = 0; j <= i; j++)
                Console.Write('*');
        }
        Console.ResetColor();
    }
}
